{
  "name": "mecut",
  "version": "1.0.0",
  "description": "Autonomous coding loop CLI - repeatedly drives an AI over your project until the timer runs out",
  "type": "module",
  "bin": {
    "mecut": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "node-pty": "^1.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
